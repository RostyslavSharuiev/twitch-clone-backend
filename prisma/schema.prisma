generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  email    String @unique
  password String

  username    String  @unique
  displayName String  @map("display_name")
  avatar      String?
  bio         String?

  isVerified      Boolean @default(false) @map("is_verified")
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  isTotpEnabled   Boolean @default(false) @map("is_totp_enabled")
  totpSecret      String? @map("totp_secret")

  isDeactivated Boolean   @default(false) @map("is_deactivated")
  deactivateAt  DateTime? @map("deactivate_at")

  tokens       Token[]
  socialLinks  SocialLink[]
  stream       Stream?
  chatMessages ChatMessage[]

  followers  Follow[] @relation(name: "followers")
  followings Follow[] @relation(name: "followings")

  @@map("users")
}

model SocialLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title    String
  url      String
  position Int

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  @@map("social_links")
}

model Token {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  @@map("tokens")
}

model Stream {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title        String
  thumbnailUrl String? @map("thumbnail_url")

  isLive                     Boolean @default(false) @map("is_live")
  isChatEnabled              Boolean @default(true) @map("is_chat_enabled")
  isChatFollowersOnly        Boolean @default(false) @map("is_chat_followers_only")
  isChatPremiumFollowersOnly Boolean @default(false) @map("is_chat_premium_followers_only")

  ingressId String? @unique @map("ingress_id")
  serverUrl String? @map("server_url")
  streamKey String? @map("stream_key")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?       @unique @map("user_id")
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?       @map("category_id")
  chatMessages ChatMessage[]

  @@map("stream")
}

model ChatMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  text String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId String @map("stream_id")

  @@map("chat_messages")
}

model Category {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  title        String
  slug         String  @unique
  description  String?
  thumbnailUrl String  @map("thumbnail_url")

  streams Stream[]

  @@map("categories")
}

model Follow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  follower    User   @relation(name: "followers", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String @map("follower_id")
  following   User   @relation(name: "followings", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String @map("following_id")

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  DEACTIVATE_ACCOUNT

  @@map("token_types")
}
